# OpenClaw maintenance workers. Copy to army.env; the active local file is
# ignored by Git and is read by ops/army/bin/start_army.sh.

# Enable the read-only Codex advisor and optional parallel swarm advisor.
# Keep the swarm disabled until its higher cost and output are reviewed.
ARMY_ENABLE_CODEX=1
ARMY_ENABLE_SWARM=0

# Worker schedule in minutes. Values control periodic observation, verification,
# advisor runs and optional swarm runs; keep these intervals above job duration.
ARMY_OBSERVE_INTERVAL_MIN=15
ARMY_VERIFY_INTERVAL_MIN=30
ARMY_ADVISOR_INTERVAL_MIN=60
ARMY_SWARM_INTERVAL_MIN=360

# Absolute checkout path used by all worker scripts and their service processes.
BOT_ROOT=/home/administrator/bot

# Optional Router endpoint and secret. Without a key, Router health probing is
# skipped; do not commit a populated army.env.
ROUTER_BASE_URL=https://test-router.yeying.pub/v1
# ROUTER_API_KEY=

# Codex advisor budget and sandbox. Keep read-only mode so generated output is
# a recommendation only; code changes still require a human-reviewed PR.
ARMY_CODEX_TIMEOUT_SEC=420
ARMY_CODEX_SANDBOX=read-only
