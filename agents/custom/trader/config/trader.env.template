# Trader service settings. Copy to config/trader.env; secrets belong in that
# ignored local file, not in this template.

# Process execution settings. The CLI selects one-shot or continuous operation;
# there is no separate bind-mode setting in the current implementation.
# Delay between continuous loop cycles, in seconds.
TRADER_LOOP_INTERVAL_SECONDS=300
# Python logging level: DEBUG, INFO, WARNING or ERROR.
TRADER_LOG_LEVEL=INFO
# Database, snapshots and logs. Keep generated runtime data out of source control.
TRADER_RUNTIME_DIR=runtime
# Strategy file; bootstrap creates it from strategies.yaml.template if missing.
TRADER_STRATEGY_FILE=config/strategies.yaml

# Current brokers are paper and eastmoney_stub; neither is a production live
# brokerage integration. This template is not a live-trading configuration.
TRADER_BROKER=paper
# Market-data provider: dsa or ifind, depending on the installed adapter.
TRADER_MARKET_PROVIDER=dsa

# iFinD provider. Configure at least one token only when MARKET_PROVIDER=ifind.
IFIND_BASE_URL=https://quantapi.51ifind.com/api/v1
IFIND_ACCESS_TOKEN=
IFIND_REFRESH_TOKEN=
# HTTP timeout for each market-data request, in milliseconds.
IFIND_REQUEST_TIMEOUT_MS=30000

# Optional daily_stock_analysis integration. The default is inferred from the
# project layout; use an absolute path when the sibling checkout differs.
TRADER_EASTMONEY_ACCOUNT_ID=demo-eastmoney
TRADER_DSA_ROOT=../../../../daily_stock_analysis
# Interpreter with DSA dependencies installed.
TRADER_DSA_PYTHON_BIN=python
# Market passed to the external analysis tool.
TRADER_DSA_MARKET=cn
# Opt into AlphaSift only when it is installed and configured.
TRADER_DSA_USE_ALPHASIFT=false
# Maximum runtime per external analysis call, in seconds.
TRADER_DSA_TIMEOUT_SECONDS=120
# Named screening strategy supported by DSA.
TRADER_DSA_SCREENING_STRATEGY=dual_low
# Cap candidates returned from screening.
TRADER_DSA_SCREENING_MAX_RESULTS=12
# Candidate counts used by optional hot-stock and limit-up data queries.
TRADER_DSA_HOT_STOCK_COUNT=10
TRADER_DSA_LIMIT_UP_COUNT=12
# Number of concepts/sectors included when their data sources are enabled.
TRADER_DSA_CONCEPT_TOP_N=5
TRADER_DSA_SECTOR_TOP_N=5
# Historical lookback for DSA analysis, in days.
TRADER_DSA_HISTORY_DAYS=40
# Each optional data family is disabled by default to limit external requests.
TRADER_DSA_ENABLE_MARKET_STATS=false
TRADER_DSA_ENABLE_HOT_STOCKS=false
TRADER_DSA_ENABLE_LIMIT_UP_POOL=false
TRADER_DSA_ENABLE_SECTOR_RANKINGS=false
TRADER_DSA_ENABLE_CONCEPT_RANKINGS=false
