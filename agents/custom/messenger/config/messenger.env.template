# Messenger configuration contract for a future standalone runtime.
# The current multi-instance control plane is implemented in backend/ and does
# not currently load this file. Do not copy Orchestrator HUB_* service settings
# here; those have one source at backend/.env.

# Root directory for Messenger-owned instance data if/when its runtime consumes
# this file. Resolve relative paths from the repository root.
MESSENGER_INSTANCES_ROOT=runtime/instances

# Model id selected for newly created Messenger instances; must be in the
# control plane's model allowlist when creation is delegated to Orchestrator.
MESSENGER_DEFAULT_MODEL=gpt-5.3-codex

# Reserved for a future Messenger-specific management API. It is not an
# Orchestrator admin credential and should not reuse HUB_ADMIN_TOKEN.
MESSENGER_ADMIN_TOKEN=
