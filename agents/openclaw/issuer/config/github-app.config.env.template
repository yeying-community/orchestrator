# Issuer GitHub App and attachment-storage settings.
#
# Copy to config/github-app.config.env, then replace sample values. This local
# file contains credentials and is intentionally excluded from source control.
# The tools load it automatically; the key file should remain in secrets/ with
# restrictive filesystem permissions.
#
# Local destination:
#   config/github-app.config.env

# GitHub App numeric id and path to its PEM private key, relative to APP_DIR or
# absolute. Never paste the private key contents into this env file.
GITHUB_APP_ID=1234567
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem

# Optional installation id. Leave empty to resolve it from the configured
# owner/repository at runtime.
GITHUB_APP_INSTALLATION_ID=

# Default target for CLI operations that omit --owner and --repo.
GITHUB_DEFAULT_OWNER=yeying-community
GITHUB_DEFAULT_REPO=agent

# WebDAV destination and public-share API used when an issue/comment includes
# attachments. Fill only when attachment upload is enabled for this deployment.
WEBDAV_BASE_URL=https://webdav.example.com/dav/personal/issue-pictures
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_PUBLIC_SHARE_API_URL=https://webdav.example.com/api/v1/public/share/create
WEBDAV_PUBLIC_SHARE_BEARER_TOKEN=

# Optional aliases for providers that call WebDAV credentials Key ID/Key Secret.
WEBDAV_KEY_ID=
WEBDAV_KEY_SECRET=

# Maximum accepted attachment size in bytes. Keep within storage-provider limits.
GITHUB_ATTACHMENT_MAX_BYTES=5242880
