# =========================
# Coder Bot 配置模板
# =========================
# 用法：复制为 config/coder-bot.env 后按下方说明填写。该文件包含 GitHub、飞书
# 和模型执行凭证；仅允许服务账号读取，绝不要提交真实配置或私钥。

# -------------------------
# APP_HOME 是相对路径的解析基准；数据、密钥和日志目录均相对 APP_HOME。
# -------------------------
APP_HOME=..
DATA_DIR=data
SECRETS_DIR=secrets
LOG_DIR=data/logs

# -------------------------
# API 监听地址。公网部署应放在带 TLS 的反向代理后，并限制直接访问。
# -------------------------
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9081

# -------------------------
# GitHub App 凭证。私钥放在 GITHUB_PRIVATE_KEY_PATH 指向的文件中，不粘贴进 env。
# GITHUB_INSTALLATION_ID 用于源仓库；FORK_INSTALLATION_ID 用于提交代码的 fork。
# GITHUB_FORK_OWNER 填当前贡献者 fork 的 GitHub 用户或组织名。
# -------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_FORK_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=secrets/github-app.pem
GITHUB_CLONE_SSH_KEY_PATH=secrets/github-push-key
GITHUB_FORK_OWNER=your-github-name

# -------------------------
# 允许处理的仓库
# -------------------------
# 多个允许受理的上游仓库用英文逗号分隔；不要把不受信任仓库加入白名单。
# 示例：
# ALLOWED_REPOS=yeying-community/deployer,yeying-community/agent
ALLOWED_REPOS=upstream-owner/repo-name
# 可选仓库短名映射，格式为 alias=owner/repo，多项用逗号分隔。
# REPO_ALIASES=deployer=yeying-community/deployer,agent=yeying-community/agent

# -------------------------
# 执行后端
# -------------------------
# EXECUTION_BACKEND 只在未显式选择模型时作为默认值；当前支持 codex/claude。
# 命令行、模型名、超时、可用模型清单与运行目录分别配置在下方。
# CODEX_SOURCE_HOME 是登录凭证来源；CODEX_RUNTIME_HOME 是机器人隔离运行目录。
# 只有在完全理解隔离边界后才启用危险沙箱绕过选项。
EXECUTION_BACKEND=codex
ISSUE_SESSION_PREFIX=gh
CODEX_BIN=codex
CODEX_MODEL=
SUPPORTED_CODEX_MODELS=gpt-5.2,gpt-5.3-codex,gpt-5.4,gpt-5.4-mini,gpt-5.5
CODEX_TIMEOUT=3600
CODEX_SOURCE_HOME=~/.codex
CODEX_RUNTIME_HOME=data/codex/home
# true adds Codex's approval/sandbox bypass flag. Use only in a disposable,
# isolated worker environment; prefer false wherever the worker can reach host data.
CODEX_USE_DANGEROUSLY_BYPASS=true
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-4-6
SUPPORTED_CLAUDE_MODELS=claude-haiku-4-5-20251001,claude-opus-4-6,claude-opus-4-6-thinking,claude-opus-4-7,claude-sonnet-4-6
CLAUDE_TIMEOUT=3600
ISSUE_BRANCH_PREFIX=coder

# -------------------------
# Feishu handoff
# -------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_HANDOFF_CHAT_ID=
# 多个允许作为任务入口的顶层群 ID，用英文逗号分隔；结果回到发起群的线程。
FEISHU_HANDOFF_CHAT_IDS=
FEISHU_CONFIRM_KEYWORDS=/run,开始执行,确认执行,可以执行,方案1,方案一,执行方案1,执行方案一
FEISHU_CHAT_SCAN_LIMIT=30
FEISHU_THREAD_SCAN_LIMIT=30

# -------------------------
# 数据库、任务、仓库克隆、活跃任务和状态文件位置。应放在持久化磁盘上。
# -------------------------
DB_PATH=data/issue_bot.db
JOB_ROOT=data/jobs
REPO_ROOT=data/repos
REPO_LOCK_WAIT_SECONDS=7200
ACTIVE_DIR=data/active
STATE_FILE=data/state.json
SYNC_SCRIPT_PATH=scripts/sync.sh

# -------------------------
# PR 标题、Git author、自动评论和目标 base branch 的默认行为。
# -------------------------
PR_TITLE_PREFIX=[Coder]
# 可选：覆盖智能体提交代码时使用的 git author
GIT_AUTHOR_NAME=Coder
GIT_AUTHOR_EMAIL=coder-bot@local
SUBMIT_COMMENT_AFTER_PR=true
SUBMIT_COMMENT_BODY=/submit
DEFAULT_BASE_BRANCH=

# -------------------------
# 测试命令
# -------------------------
# 默认建议留空，由执行模型自行决定需要的最小验证。
TEST_COMMAND=

# -------------------------
# 后台派发轮询间隔和等待子进程完成的最长秒数。
# -------------------------
DISPATCH_INTERVAL_SECONDS=5
FORK_WAIT_TIMEOUT_SECONDS=300
