# ===== Orchestrator Service Configuration Template =====
#
# Copy to backend/.env in each environment, then set environment-specific values:
#   cp backend/.env.template backend/.env
#
# This is the single Orchestrator service config for local and production use.
# Keep credentials out of Git; backend/.env is ignored.

# HTTP bind address for the API and bundled web UI, in host:port form.
# Keep loopback for local development; expose production traffic only through a
# TLS reverse proxy and bind to the private service interface as appropriate.
HUB_BIND_ADDR=127.0.0.1:3900

# Optional absolute repository root used to locate agents/, web/dist and scripts.
# Usually leave empty; the backend infers it when started from this checkout.
# HUB_REPO_ROOT=/Users/yourname/Workspace/opensource/orchestrator

# Persistent control-plane files and managed instance directories. Defaults are
# under repo-root/runtime for local development. Set absolute writable paths
# outside the source checkout in production and back them up with the database.
# HUB_RUNTIME_DIR=/Users/yourname/Workspace/opensource/orchestrator/runtime/control-plane
# HUB_INSTANCES_ROOT=/Users/yourname/Workspace/opensource/orchestrator/runtime/instances

# PostgreSQL stores authoritative instance/task/session metadata. It is strongly
# recommended locally and required for multi-process/production operation.
# If unset, the service falls back to single-process JSON storage for quick experiments only.
# When configured, run `cd backend && uv run alembic upgrade head` before startup
# and after application upgrades. URL format: postgresql+psycopg://user:password@host:5432/db.
# HUB_DATABASE_URL=postgresql+psycopg://orchestrator:<local-password>@127.0.0.1:5432/orchestrator

# Stable identity for this control-plane host. Do not reuse one id for distinct
# hosts if Runtime Node enrollment is enabled.
HUB_NODE_ID=local
# Runtime Node heartbeat credentials, keyed by node id. Provision a unique,
# random token of at least 32 characters per node. A list of up to three tokens
# allows an overlap during manual rotation. Keep this JSON compact; inject real
# secrets through the service environment rather than committing them here.
# HUB_RUNTIME_NODE_TOKENS={"node-1":"<at-least-32-character-random-token>"}
# Seconds without heartbeat before a Runtime Node is reported offline (1..3600).
HUB_RUNTIME_NODE_OFFLINE_AFTER_SECONDS=90
# Reserved path for an external secret-store integration; the current release
# does not automatically read secrets from this directory.
# HUB_SECRET_STORE_DIR=/Users/yourname/Library/Application Support/orchestrator/secrets

# Optional Warehouse event archive. The separate outbox worker needs both URL
# and a short-lived scoped token; this does not make Warehouse the source of truth.
# YEYING_WAREHOUSE_URL=http://127.0.0.1:6065
# YEYING_WAREHOUSE_TOOL_TOKEN=<short-lived-scoped-token>
# YEYING_WAREHOUSE_ARCHIVE_PREFIX=/services/orchestrator/events
# YEYING_WAREHOUSE_REQUEST_TIMEOUT_SECONDS=10

# Public HTTPS origin included in wallet-signing challenges. Leave empty for
# local development; production must match the URL users see in their browser.
HUB_PUBLIC_BASE_URL=

# Model Router API origin and server-side API key. The key is never sent to the
# browser. Set a production endpoint and secret before creating live instances.
ROUTER_BASE_URL=https://test-router.yeying.pub/v1
ROUTER_API_KEY=

# Default model and comma-separated allowlist offered when provisioning an
# OpenClaw runtime. The default should also appear in the allowlist.
HUB_DEFAULT_MODEL=gpt-5.3-codex
HUB_MODEL_ALLOWLIST=gpt-5.3-codex,gpt-5.1-mini

# Wallet challenge and browser session lifetime in seconds.
HUB_CHALLENGE_TTL_SECONDS=300
HUB_SESSION_TTL_SECONDS=86400

# Random signing secret for session/challenge state. The example is local-only;
# replace it in production with a high-entropy value and keep it stable across
# restarts. Rotate only with existing sessions invalidated.
HUB_SESSION_SECRET=change-me-control-plane-session-secret

# Cookie Secure policy: auto follows HTTPS/proxy headers; always requires HTTPS;
# never is only for local HTTP development because browsers send that cookie unencrypted.
HUB_SESSION_COOKIE_SECURE_MODE=never

# Inclusive port range from which local OpenClaw instance gateways are allocated.
HUB_INSTANCE_PORT_START=18800
HUB_INSTANCE_PORT_END=18999

# Independent credentials: admin is operator-only (for example, the global
# Runtime Node inventory endpoint), internal is Project-to-Orchestrator, and
# worker is for the separately launched lifecycle executor. The default admin
# placeholder is deliberately rejected by that endpoint. Replace example
# values with high-entropy secrets and never reuse one across these boundaries.
HUB_ADMIN_TOKEN=change-me-admin-token
HUB_INTERNAL_TOKEN=change-me-internal-token
# Required only when enabling the lifecycle worker; use a different random token.
HUB_WORKER_TOKEN=
# Worker execution is disabled by default. Enable only after deployment security
# prerequisites in docs/operations.md are reviewed.
HUB_RUNTIME_EXECUTOR_ENABLED=false
# Worker API origin. Use HTTPS except for loopback development deployments.
HUB_WORKER_API_URL=http://127.0.0.1:3900
# Optional stable worker label; generated automatically if empty.
HUB_WORKER_ID=
# Lease duration and retry ceiling for claimed lifecycle tasks.
HUB_WORKER_LEASE_SECONDS=300
HUB_WORKER_MAX_ATTEMPTS=5
# Node Registry deployment credentials. Configure only on a host running the
# lifecycle worker; trust publisher public keys out-of-band and manage rotation.
# NODE_REGISTRY_URL=https://node.example.com
# NODE_RUNTIME_INSTANCE_ID=runtime-instance-id
# NODE_RUNTIME_AGENT_ID=orchestrator
# NODE_RUNTIME_TOKEN=<node-runtime-token>
# NODE_TRUSTED_PUBLISHER_KEYS={"publisher-key-id":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
# Mutable release storage, local app secrets (0600 JSON files), and the public
# app origin used to build runtime environment. Keep paths outside the checkout.
# HUB_APPLICATIONS_DIR=/var/lib/orchestrator/applications
# HUB_APPLICATION_CONFIG_DIR=/var/lib/orchestrator/app-config
# HUB_APPLICATION_PUBLIC_BASE_URL=https://apps.example.com

# Optional executable prefix used when launching local OpenClaw processes, e.g.
# proxychains4 -q. Leave empty for a direct launch.
# HUB_OPENCLAW_PREFIX=proxychains4 -q
HUB_OPENCLAW_PREFIX=
